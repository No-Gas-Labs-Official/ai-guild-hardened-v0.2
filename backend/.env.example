# Server Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=No-Gas-Labs Ops Intelligence

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nogaslabs_ops
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GitHub Configuration
GITHUB_TOKEN=GITHUB_TOKEN_REMOVED

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Agent Configuration
AGENT_SCHEDULE_ENABLED=true
AGENT_MAX_CONCURRENT_TASKS=10

# Security Configuration
BCRYPT_ROUNDS=12
HELMET_ENABLED=true

# Autonomous Liver daemon (rewrites source files on disk — keep disabled unless intentional)
LIVER_DAEMON_ENABLED=false

# Performance Configuration
COMPRESSION_ENABLED=true
CACHE_TTL=3600