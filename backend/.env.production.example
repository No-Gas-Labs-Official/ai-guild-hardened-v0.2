# Production template only. Store actual values in an approved secret manager, never in Git.
NODE_ENV=production
PORT=3000
APP_READ_ONLY=true
APP_CORS_ORIGINS=https://console.example.test
APP_BODY_LIMIT_BYTES=1048576
APP_RATE_LIMIT_WINDOW_MS=900000
APP_RATE_LIMIT_MAX=100
ENABLE_PUBLIC_UPLOADS=false

# Required production secret. Use a non-placeholder value of at least 32 characters.
JWT_SECRET=replace-through-approved-secret-manager

# Required future data-service settings. The hardening baseline does not connect or migrate them.
DB_HOST=replace-through-approved-infrastructure
DB_PORT=5432
DB_NAME=replace-through-approved-infrastructure
DB_USER=replace-through-approved-secret-manager
DB_PASSWORD=replace-through-approved-secret-manager
REDIS_HOST=replace-through-approved-infrastructure
REDIS_PORT=6379
REDIS_PASSWORD=replace-through-approved-secret-manager
